# Database (Neon PostgreSQL connection pooled and unpooled URLs)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Security
SESSION_SECRET="replace-with-a-secure-random-32-byte-secret"

# Initial Admin Credentials (used during db seed)
INITIAL_ADMIN_NAME="Barch Administrator"
INITIAL_ADMIN_EMAIL="admin@barchcoffee.com"
INITIAL_ADMIN_PASSWORD="ChangeMeInProduction123!"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CAFE_NAME="Barch Coffee"
NEXT_PUBLIC_CURRENCY="ETB"
